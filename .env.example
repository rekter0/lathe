# Lathe reads these from the launching process; it does not load this file.
# Leave the database URL unset for SQLite at LATHE_DATA_DIR/lathe.sqlite.
# LATHE_DATABASE_URL=postgresql://lathe:lathe@127.0.0.1:5432/lathe
# LATHE_DATA_DIR=/absolute/path/to/lathe-data
LATHE_HOST=127.0.0.1
LATHE_PORT=4317

# Leave unset to generate a fresh launch token each time. Never commit a real token.
# LATHE_API_TOKEN=replace-for-controlled-automation-only

# Used only by the development server's printed link when the built UI is absent.
# LATHE_WEB_URL=http://127.0.0.1:5173

# Optional repository contract-test database. Use a disposable database.
# LATHE_TEST_POSTGRES_URL=postgresql://lathe:lathe@127.0.0.1:5432/lathe_test
